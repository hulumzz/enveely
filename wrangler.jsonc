{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "enveely",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "PAYMENTS_DB",
      "database_name": "enveely-payments",
      "database_id": "6fa7675b-73e4-4138-8262-7100d120db83",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PAYMENT_PROOFS",
      "bucket_name": "enveely-payment-proofs"
    }
  ],
  "ai": { "binding": "AI" },
  "vars": {
    "FIREBASE_PROJECT_ID": "ulwed-d729f"
  }
}
