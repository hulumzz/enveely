{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "enveely",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "PAYMENTS_DB",
      "database_name": "enveely-payments",
      "database_id": "a15c57f9-3cce-4fee-a7d7-79afb07a9ee1",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PAYMENT_PROOFS",
      "bucket_name": "enveely-payment-proofs"
    },
    {
      "binding": "INVITATION_MEDIA",
      "bucket_name": "enveely-invitation-media"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "ulwed-d729f",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFS3HShRp2B8kxOl"
  },
  "env": {
    "preview": {
      "d1_databases": [],
      "r2_buckets": [],
      "vars": {
        "FIREBASE_PROJECT_ID": "ulwed-d729f"
      }
    }
  }
}
