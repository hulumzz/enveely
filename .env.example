# Enveely environment configuration
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# NOTE: keep this template file EMPTY of real keys — move any real key
# into .env.local only, then rotate the exposed key.

# ---- Firebase (web client config) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ulwed-d729f.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ulwed-d729f
VITE_FIREBASE_STORAGE_BUCKET=ulwed-d729f.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ---- Image hosting providers ----
# ImgBB: primary provider. Get key at https://api.imgbb.com/
VITE_IMGBB_API_KEY=
# Freeimage.host: failover provider. Get key at https://freeimage.host/
VITE_FREEIMAGE_API_KEY=

# ---- Upload limits ----
# Max source file size in MB before compression
VITE_MAX_UPLOAD_MB=15
# Longest edge in px after client-side resize
VITE_IMAGE_MAX_EDGE=1600
# JPEG quality for re-encoding (0..1)
VITE_IMAGE_QUALITY=0.85
# Static merchant QRIS payload. Keep the real value in .env.local / encrypted
# Cloudflare environment variables; never commit merchant payloads.
VITE_QRIS_STATIC_PAYLOAD=
