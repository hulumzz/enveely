{
  "name": "enveely",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "Enveely by Nalaro Digital. Digital invitation platform.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "preview:pages": "wrangler pages dev dist",
    "test": "node tests/atelier.test.mjs && node tests/preview-layout.test.mjs && node tests/payment-functions.test.mjs && node tests/guest-functions.test.mjs && node tests/admin-insights.test.mjs",
    "test:rules": "node scripts/test-rules.mjs",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "prebuild": "node scripts/build-policy.mjs && node scripts/build-sitemap.mjs",
    "test:functions": "wrangler pages functions build functions --outdir=/tmp/enveely-functions-check",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "vite": "^8.3.3",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  }
}
