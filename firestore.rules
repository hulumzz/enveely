rules_version = '2';

// Enveely — Firestore Security Rules (least privilege, no-login MVP).
//
// Model:
//   /invitations/{invId}            -> invitation content + design + status
//   /invitations/{invId}/rsvps/{id} -> guest RSVP submissions
//   /invitations/{invId}/wishes/{id}-> guest wishes (approval flow later)
//   /invitationControl/{invId}      -> private control doc (deviceId ownership)
//
// Ownership: the browser-generated deviceId is NOT strong identity; it only
// scopes draft access per installation (Blueprint-1.md §8). Public reads are
// limited to status == 'published'. Never use global allow read/write: true.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Invitations ----------
    match /invitations/{invitationId} {
      // Public: only published invitations are readable.
      allow get: if resource != null && resource.data.status == 'published';
      // Drafts: readable/updated by the owning device via explicit query filter.
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.status == 'draft'
        && request.resource.data.deviceId == request.auth.token.deviceId;
      allow update: if isOwner()
        && resource.data.deviceId == request.auth.token.deviceId;
      allow delete: if isOwner();

      // ---------- RSVPs (public create with field validation) ----------
      match /rsvps/{rsvpId} {
        allow read: if isOwner();
        allow create: if validRsvp();
        allow update, delete: if false; // immutable guest submissions
      }

      // ---------- Wishes (public create, owner moderation) ----------
      match /wishes/{wishId} {
        allow read: if isOwner() || wishesPublic(invitationId);
        allow create: if validWish();
        allow update, delete: if isOwner();
      }
    }

    // ---------- Invitation control docs (private) ----------
    match /invitationControl/{invitationId} {
      allow read, write: if isOwner();
    }

    // ---------- Templates (read-only public catalog when moved to DB) ----------
    match /templates/{templateId} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- Helpers ----------

    // deviceId matching on the REQUEST payload. In this no-login MVP the
    // client includes its deviceId in writes and in queries for drafts.
    function isOwner() {
      return request.resource != null
        && request.resource.data.keys().hasAny(['deviceId'])
        ? true
        : existingDataOwnedByCaller();
    }

    function existingDataOwnedByCaller() {
      return resource != null && resource.data.deviceId == deviceToken();
    }

    function deviceToken() {
      // Client passes deviceId as a query constraint; rules compare against
      // request.query values where available.
      return request.query.deviceId;
    }

    function wishesPublic(invitationId) {
      return get(/databases/$(database)/documents/invitations/$(invitationId)).data.wishesEnabled == true;
    }

    function validRsvp() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'attendance', 'guestCount', 'message', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.attendance in ['attending', 'not-attending']
        && d.guestCount is int && d.guestCount >= 1 && d.guestCount <= 20
        && (!('message' in d) || (d.message is string && d.message.size() <= 500));
    }

    function validWish() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'message', 'approved', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.message is string && d.message.size() > 0 && d.message.size() <= 500
        && ('approved' not in d || d.approved == false);
    }
  }
}
